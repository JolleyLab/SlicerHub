# Settings and secrets. Copy to .env, or let `node scripts/bootstrap.mjs` create it.
# NEVER commit .env. On a server, make it readable by its owner only (chmod 600).
#
# bootstrap.mjs generates the secrets a setup needs (DB passwords, KEYCLOAK_ADMIN_PASSWORD,
# PAYLOAD_SECRET, AUTH_TOKEN_KEY); setup-keycloak.mjs writes KEYCLOAK_CLIENT_SECRET.
# To generate one by hand:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# More: docs/secrets-management.md

# --- Active compose profiles ---
# Comma-separated list of profiles to enable by default.
# Common combinations:
#   keycloak          — Keycloak IdP only
#   payload           — Payload CMS + Postgres only
#   keycloak,payload  — both (typical dev setup with auth + Cases)
# COMPOSE_PROFILES=keycloak,payload

# --- Required for production ---
NODE_ENV=production
JWT_SECRET=
GPU_CREDENTIALS_KEY=
TRAME_SYNC_TOKEN=
CORS_ORIGINS=https://your-domain.example

# Sign-in provider: keycloak (the product setup; bootstrap.mjs sets it).
# AUTH_PROVIDER=keycloak
#
# Sign-in, sign-up and password reset are Keycloak's own pages at /sso/ (OpenID Connect
# + PKCE); the app never sees passwords. See docs/redirect-login-and-sessions-design.md.

# --- Keycloak (compose profile: keycloak) ---
# Start with: docker compose --profile keycloak up -d
# Admin console: http://localhost:8082  (dev only)
#
# Realm + client config is imported from keycloak/realms/ on first start.
# Export updated realm: docker exec keycloak /opt/keycloak/bin/kc.sh export --realm slicer-web --dir /tmp/export
#
# KEYCLOAK_URL=http://keycloak:8080          # internal (backend → keycloak over trame-net)
# KEYCLOAK_ADMIN_URL=http://localhost:8082   # host-accessible; used by setup-keycloak.mjs (default 8082)
#                                            # and as Keycloak's admin-console hostname (localhost only)
#
# Browsers reach Keycloak's sign-in pages through nginx at <PUBLIC_APP_URL>/sso/, so
# PUBLIC_APP_URL (below) must be the real public origin in production. The admin console
# and master realm are blocked at /sso/ — use KEYCLOAK_ADMIN_URL over SSH/localhost.
# KEYCLOAK_START_COMMAND=start               # production mode (default: start-dev for local)
#
# After pulling realm-config changes, apply them without rotating the client secret:
#   node scripts/setup-keycloak.mjs --settings-only
# KEYCLOAK_REALM=slicer-web
# KEYCLOAK_CLIENT_ID=slicer-web-backend
# KEYCLOAK_CLIENT_SECRET=                   # set in Keycloak admin console, copy here
# KEYCLOAK_DB_USER=keycloak                 # matches docker-compose default
# KEYCLOAK_DB_PASSWORD=                     # set a real password in production
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=                  # set a real password in production; the backend uses it for
#                                            # Keycloak admin calls (roles, invites, account checks)
#
# Dev test user — created/updated by setup-keycloak.mjs when set (skipped if blank).
# NEVER set these in production. Use a clearly fake dev password.
# KEYCLOAK_TEST_USER_EMAIL=dev@example.com
# KEYCLOAK_TEST_USER_ROLE=app-admin         # default: app-admin
# (password is prompted at bootstrap time and never stored)

# Encrypts the Keycloak ID token kept on each session (for sign-out). Set a dedicated
# random value in production; without it a fallback key is used and the backend warns.
# AUTH_TOKEN_KEY=
# AUTH_TOKEN_KEY_PREVIOUS=                   # during key rotation (decrypt only)
#
# Auth audit retention days (event, user id, time only — no IP, user agent or email; default 30)
# AUTH_AUDIT_RETENTION_DAYS=30
#
# AUTH_DEV_RELAXED=true lengthens idle sessions and shows a banner on the sign-in card.
# Forbidden in production (startup fails if set). Sign-in lockout is Keycloak's
# brute-force detection (scripts/setup-keycloak.mjs), not an app setting.
# AUTH_DEV_RELAXED=true

# Secure cookies when TLS terminates at a reverse proxy
# COOKIE_SECURE=true

# --- Docker stack (internal) ---
# TRAME_SERVICE_URL=http://trame-service:8090
# TRAME_IMAGE=slicer-web-trame:local
# WORKSPACE_ROOT=/workspace
# HOST_WORKSPACE_ROOT=/path/on/host/slicer-web
# SLICER_GUI_MOUNT_DEV_SCRIPTS=true   # only for iterating launch-slicer.sh without rebuild
# Docker Desktop on Windows (WSL2) only: render Trame + Full Slicer sessions on the GPU via Mesa D3D12
# (no NVIDIA EGL in WSL containers, so they otherwise fall back to CPU llvmpipe). Leave unset on Linux.
# CONTAINER_GL_MODE=d3d12

# --- Session / billing timeouts (defaults shown) ---
# SESSION_TTL_SECONDS=1800
# SESSION_IDLE_MINUTES=30      # signed out after this long without real use (keys, pointer, viewer)
# SESSION_MAX_HOURS=12          # re-enter the password this long after signing in
#
# Procedure mode (keep a theatre workstation signed in for a long case).
# Hard cap 24 h in code; sites can lower it. Set ENABLED=false to turn the feature off.
# PROCEDURE_MODE_ENABLED=true
# PROCEDURE_MODE_DEFAULT_HOURS=8
# PROCEDURE_MODE_MAX_HOURS=24
# MAX_SESSION_WALL_SECONDS=28800
# GPU_BILLING_IDLE_MINUTES=60
# GPU_BILLING_MAX_WALL_MINUTES=480
# GPU_VIEWER_SESSION_TTL_SECONDS=1800
# GPU_VIEWER_LEAVE_GRACE_MINUTES=10
# Full Slicer attached lease (raise if Edge Sleeping Tabs drop heartbeats):
# SLICER_GUI_SESSION_TTL_SECONDS=900
# SLICER_GUI_WARM_IDLE_SECONDS=1800
# Concurrent Full Slicer seats per user (separate containers; default 2):
# SLICER_GUI_MAX_SEATS_PER_USER=2

# --- Vast GPU (required if using remote billing) ---
# VAST_GPU_IMAGE=youruser/slicer-vast-gpu:latest
# VAST_MAX_DPH=2.0
# Prefer stable hosts (reduces Docker ping_group_range failures on cheap pools):
# VAST_MIN_RELIABILITY=0.98
# TRAME_VIEWER_PUBLIC_BASE_URL=

# --- Optional standalone Slicer GUI (compose profile slicer-gui) ---
# Required when starting: docker compose --profile slicer-gui up -d slicer-gui
# VNC auth is disabled by default for this stack (local/demo). Set false + VNC_PASSWORD to enable.
# VNC_ALLOW_NO_PASSWORD=true
# VNC_PASSWORD=your-secret
# Heavy desktop base (local today; set to a Hub/GHCR tag when upstream publishes):
# SLICER_GUI_BASE_IMAGE=slicer-web-slicer-gui-base:local
# Runtime adapter used by the backend (open-request poller + optional SimplifiedViewer):
# SLICER_GUI_IMAGE=slicer-web-slicer-gui:local
# When BASE is a registry image, set SLICER_GUI_BUILD_BASE=false and only rebuild the adapter.
# SLICER_GUI_BUILD_BASE=auto
# Catalog extensions override (default: slicer-addons.json). Space-separated:
# SLICER_EXTENSIONS=Sandbox SlicerHeart
# Scripted modules: edit slicer-gui-gpu/slicer-addons.json, then set repo env(s):
# SLICER_HEART_VIEWER_REPO=
# SLICER_HEART_VIEWER_REF=
# Daily host sync (no image push). Default tree: data/slicer-addons
#   cd slicer-gui-gpu && .\sync-slicer-addons.ps1
# SLICER_ADDONS_HOST_DIR=
# LOCAL_SLICER_GUI_URL=http://localhost:8000/slicer-gui/

# LOCAL_SLICER_GUI_PATH=/slicer-gui/vnc.html?autoconnect=true&resize=remote

# --- Optional ---
# CLOUDFLARED_TUNNEL_TOKEN=

# Set true to show "My Files" in the sidebar nav (hidden by default)
# ENABLE_MY_FILES=true

# --- Case invites to a new email (Keycloak emails the account-setup link) ---
# Browser origin used in invite URLs and as Keycloak's public base (<this>/sso).
# Required in production — default http://localhost:8000.
# PUBLIC_APP_URL=http://localhost:8000
# CASE_INVITE_TTL_DAYS=7
#
# SMTP — used by the app (reviewer and approval emails) and copied into Keycloak's realm
# by setup-keycloak.mjs (verify email, password reset, account setup). Without it, local
# development uses the Mailpit container (UI http://localhost:8025); production needs it.
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM=Case Invites <noreply@localhost>
# SMTP_USER=
# SMTP_PASS=
# Leave false (or unset with no host) until real SMTP is ready. Set true to enable sending.
# SMTP_ENABLED=false
# Local Mailpit test: SMTP_ENABLED=true (compose already sets SMTP_HOST=mailpit)

# SlicerWeb channel folders (defaults ./data/slicerweb-stable and ./data/slicerweb-latest).
# Override if ./data is not writable by you; set the same value in .env so docker compose mounts it.
# SLICERWEB_STABLE_DIR=
# SLICERWEB_LATEST_DIR=

# SlicerWeb auto-updater. Requires GitHub credentials for the deploy repo.
# Without credentials, channels are populated only by running scripts/fetch-slicerweb.ps1 manually.
#
# Option A — GitHub App (recommended for production, org-owned, short-lived tokens):
#   Create a GitHub App, install it on the deploy repo with read-only Contents permission.
#   SLICERWEB_GITHUB_APP_ID=          # numeric App ID from the App's settings page
#   SLICERWEB_GITHUB_APP_INSTALLATION_ID=   # from: GitHub repo → Settings → Integrations → Apps
#   SLICERWEB_GITHUB_APP_PRIVATE_KEY= # PEM content (replace newlines with \n), or use a Docker secret
#
# Option B — Fine-grained PAT (local dev / initial testing only):
#   SLICERWEB_GITHUB_TOKEN=           # read-only Contents on the deploy repo
#
# Option C — SSH deploy key (recommended; repo-scoped, no org-level permissions needed):
#   1. Generate a keypair: ssh-keygen -t ed25519 -C "slicerweb-updater" -f .secrets/slicerweb-deploy-key
#   2. Add the PUBLIC key (.pub) to the deploy repo: GitHub → Settings → Deploy keys → Add (read-only)
#   3. Set the path below to where the private key is mounted inside the container:
#   SLICERWEB_DEPLOY_KEY_PATH=/run/secrets/slicerweb/slicerweb-deploy-key
#   (docker-compose already mounts ./.secrets → /run/secrets/slicerweb inside the backend container)
#
# ENABLE_SLICERWEB_DEV_MODE=false   # set true to let users opt into the latest channel
# SLICERWEB_STABLE_CHECK_HOURS=4    # how often to auto-update stable (default 4h; 0 = disabled)

# --- Payload CMS (compose profile: payload) ---
# Start with: docker compose --profile payload up -d
# Payload runs embedded in the backend process (Local API — no extra HTTP hop).
# If PAYLOAD_DATABASE_URI is unset the backend starts normally without Cases.
#
# Connection string — matches the payload-db service defaults:
# PAYLOAD_DATABASE_URI=postgresql://payload:payload-dev-password@payload-db:5432/payload
# PAYLOAD_DB_USER=payload
# PAYLOAD_DB_PASSWORD=                    # set a real password in production
# PAYLOAD_SECRET=                         # required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Payload admin UI: http://localhost:3001/admin
# First run: visit /admin/create-first-user to create your account (one-time, in the browser).
