# Copy to .env and fill in before deploy. NEVER commit .env.
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"   # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # GPU_CREDENTIALS_KEY, TRAME_SYNC_TOKEN

# --- Required for production ---
NODE_ENV=production
JWT_SECRET=
GPU_CREDENTIALS_KEY=
TRAME_SYNC_TOKEN=
CORS_ORIGINS=https://your-domain.example

# Disable public self-registration (recommended for medical deployments)
REGISTRATION_ENABLED=false

# Login provider: "local" (SQLite; default) or "directus" (BFF password login).
# Product session is always this app's httpOnly JWT — never browser-held IdP tokens.
# AUTH_PROVIDER=local
# AUTH_PROVIDER=directus requires DIRECTUS_URL (service DIRECTUS_TOKEN is separate — Cases/jobs).
#
# Store IdP access/refresh for call-as-user Cases. Auto-enabled when ENABLE_DIRECTUS_CASES=true
# unless AUTH_STORE_PROVIDER_TOKENS=false. Production with store on requires AUTH_TOKEN_KEY.
# AUTH_STORE_PROVIDER_TOKENS=true
# AUTH_TOKEN_KEY=
# AUTH_TOKEN_KEY_PREVIOUS=
# Migrate existing local users to Directus (service token): scripts/migrate-local-users-to-directus.mjs
# Account mapping: strict (default) refuses auto-link by email alone; email enables controlled migration linking.
# AUTH_LINK_POLICY=strict
# Auth audit retention days (hashed identity + IP; default 90)
# AUTH_AUDIT_RETENTION_DAYS=90
#
# Local development (NODE_ENV=development): softer IP login ceilings and 1-minute
# account cool-down after 5 failures (override with AUTH_LOGIN_LOCKOUT_MINUTES).
# AUTH_DEV_RELAXED=true also lengthens idle sessions and shows a login banner.
# Forbidden in production (startup fails if set).
# AUTH_DEV_RELAXED=true
#
# Account cool-down after consecutive wrong passwords (soft-lock; email unlock later).
# Production default: 5 failures → 30 minutes.
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_LOCKOUT_MINUTES=30
#
# Identity direction (Cases / collab): every product user should be a Directus user (non-admin mostly).
# Prefer AUTH_PROVIDER=directus so login establishes auth_identity_links automatically.
# AUTH_PROVIDER=directus
# AUTH_IDENTITY_MODE=directus-linked
# Cases require a Directus link by default when ENABLE_DIRECTUS_CASES=true.
# Set AUTH_REQUIRE_DIRECTUS_LINK=false only for temporary local debugging.
# AUTH_REQUIRE_DIRECTUS_LINK=

# Secure cookies when TLS terminates at a reverse proxy
# COOKIE_SECURE=true

# --- Docker stack (internal) ---
# TRAME_SERVICE_URL=http://trame-service:8090
# TRAME_IMAGE=slicer-web-trame:local
# WORKSPACE_ROOT=/workspace
# HOST_WORKSPACE_ROOT=/path/on/host/slicer-web
# SLICER_GUI_MOUNT_DEV_SCRIPTS=true   # only for iterating launch-slicer.sh without rebuild

# --- Session / billing timeouts (defaults shown) ---
# SESSION_TTL_SECONDS=1800
# SESSION_IDLE_MINUTES=30
# MAX_SESSION_WALL_SECONDS=28800
# GPU_BILLING_IDLE_MINUTES=60
# GPU_BILLING_MAX_WALL_MINUTES=480
# GPU_VIEWER_SESSION_TTL_SECONDS=1800
# GPU_VIEWER_LEAVE_GRACE_MINUTES=10
# Full Slicer attached lease (raise if Edge Sleeping Tabs drop heartbeats):
# SLICER_GUI_SESSION_TTL_SECONDS=900
# SLICER_GUI_WARM_IDLE_SECONDS=1800
# Concurrent Full Slicer seats per user (separate containers; default 2):
# SLICER_GUI_MAX_SEATS_PER_USER=2

# --- Vast GPU (required if using remote billing) ---
# VAST_GPU_IMAGE=youruser/slicer-vast-gpu:latest
# VAST_MAX_DPH=2.0
# Prefer stable hosts (reduces Docker ping_group_range failures on cheap pools):
# VAST_MIN_RELIABILITY=0.98
# TRAME_VIEWER_PUBLIC_BASE_URL=

# --- Optional standalone Slicer GUI (compose profile slicer-gui) ---
# Required when starting: docker compose --profile slicer-gui up -d slicer-gui
# VNC auth is disabled by default for this stack (local/demo). Set false + VNC_PASSWORD to enable.
# VNC_ALLOW_NO_PASSWORD=true
# VNC_PASSWORD=your-secret
# Heavy desktop base (local today; set to a Hub/GHCR tag when upstream publishes):
# SLICER_GUI_BASE_IMAGE=slicer-web-slicer-gui-base:local
# Runtime adapter used by the backend (open-request poller + optional SimplifiedViewer):
# SLICER_GUI_IMAGE=slicer-web-slicer-gui:local
# When BASE is a registry image, set SLICER_GUI_BUILD_BASE=false and only rebuild the adapter.
# SLICER_GUI_BUILD_BASE=auto
# Catalog extensions override (default: slicer-addons.json). Space-separated:
# SLICER_EXTENSIONS=Sandbox SlicerHeart
# Scripted modules: edit slicer-gui-gpu/slicer-addons.json, then set repo env(s):
# SLICER_HEART_VIEWER_REPO=
# SLICER_HEART_VIEWER_REF=
# Daily host sync (no image push). Default tree: data/slicer-addons
#   cd slicer-gui-gpu && .\sync-slicer-addons.ps1
# SLICER_ADDONS_HOST_DIR=
# LOCAL_SLICER_GUI_URL=http://localhost:8000/slicer-gui/

# LOCAL_SLICER_GUI_PATH=/slicer-gui/vnc.html?autoconnect=true&resize=remote

# --- Optional ---
# CLOUDFLARED_TUNNEL_TOKEN=
# JWT_EXPIRES_IN=7d

# --- Directus (headless Cases / system jobs; service token stays server-side) ---
# DIRECTUS_URL=https://your-directus-host
# DIRECTUS_TOKEN=
# Schema bootstrap: do NOT put an admin token in .env.
# Use: node scripts/directus-schema/ensure-schema.mjs  (interactive login or --paste-token)
# See docs/directus-schema-setup.md
# DIRECTUS_CACHE_DIR=
# Set true to expose Cases nav + /api/directus/* (requires DIRECTUS_URL + DIRECTUS_TOKEN)
# ENABLE_DIRECTUS_CASES=false

# --- Admin user provision (Pattern A: temp password; Pattern B invite later) ---
# Non-admin Directus role UUID for newly created clinicians (required for bulk provision).
# DIRECTUS_DEFAULT_ROLE_ID=
# USER_PROVISION_MODE=temp_password
# Shared temporary password for a whole batch (optional; else API generates per user once).
# USER_PROVISION_DEFAULT_PASSWORD=
# Admin only: POST /api/admin/users/provision  { users: [{ email }], method?, temporaryPassword? }
# User first login: must_change_password → POST /api/auth/change-password

# --- Case signup invites (unknown email → redeem link) ---
# Browser origin used in invite URLs (default http://localhost:8000).
# PUBLIC_APP_URL=http://localhost:8000
# CASE_INVITE_TTL_DAYS=7
#
# SMTP — local compose defaults to Mailpit (UI http://localhost:8025).
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM=Case Invites <noreply@localhost>
# SMTP_USER=
# SMTP_PASS=
# Set SMTP_ENABLED=false to force copy-link only even if SMTP_HOST is set.
# SMTP_ENABLED=
