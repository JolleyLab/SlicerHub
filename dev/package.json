{
  "name": "slicer-web-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "SlicerHub web frontend (Lit), served unbundled by es-dev-server",
  "type": "module",
  "scripts": {
    "serve": "es-dev-server --node-resolve --watch --hostname 0.0.0.0 --port 8000",
    "test": "npm --prefix ../tests test",
    "licenses:check": "license-checker --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;CC0-1.0;CC-BY-3.0;CC-BY-4.0;Unlicense;0BSD;Python-2.0\" --excludePrivatePackages",
    "licenses:report": "license-checker --csv --out licenses.csv --excludePrivatePackages"
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "es-dev-server": "^1.46.1",
    "license-checker": "^25.0.1"
  },
  "dependencies": {
    "lit-element": "^2.5.1",
    "lit-html": "^1.4.1",
    "sortablejs": "^1.15.7"
  }
}
