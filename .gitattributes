# Normalize all text files to LF on commit
* text=auto eol=lf

# Shell scripts must always be LF (CRLF will break them on Linux/Docker)
*.sh text eol=lf

# Python files
*.py text eol=lf

# Dockerfiles
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Config/data files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.md text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files - no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.whl binary
*.gz binary
*.zip binary
